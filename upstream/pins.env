# Pinned upstream inputs. Changed only through the procedure in UPSTREAM.md.
# Plain KEY=value lines: sourced by scripts/*.sh. Values verified 2026-11-25.

FIREFOX_VERSION=161.0
FIREFOX_SOURCE_URL=https://archive.mozilla.org/pub/firefox/releases/161.0/source/firefox-161.0.source.tar.xz
# "Mozilla Software Releases <release@mozilla.com>" primary key. The tarball
# signature must come from this key or one of its subkeys.
MOZILLA_KEY_FINGERPRINT=14F26682D0916CDD81E37B6D61B7B526D98F0353

LIBREWOLF_REPO=https://codeberg.org/librewolf/source.git
LIBREWOLF_TAG=161.0-1
# Commit the 161.0-1 tag points to (git ls-remote, 2026-11-25). Phase 1 research
# read `main` at ed92167b4c56 (later than the tag); diff the two in Phase 2.
LIBREWOLF_COMMIT=e2baf3254fc7e0a0c5e283596c1ece62ce641716
LIBREWOLF_VERSION=161.0
LIBREWOLF_RELEASE=1

# LibreWolf's patch.sh clones its mirror (librewolf.dev/mirror/firefox-l10n) at
# whatever HEAD is current. REMILIA pre-fetches Mozilla's canonical repository
# at a pinned commit instead (reproducibility; the commit hash fixes the content
# regardless of host; this commit was confirmed present upstream 2026-11-25).
L10N_REPO=https://github.com/mozilla-l10n/firefox-l10n
L10N_COMMIT=11b93cd7123a048b79163a5efddaf7ecc27dad68

# LibreWolf's build system. REMILIA reads two files from it at this commit:
# assets/windows.mozconfig and the toolchain list in assets/Dockerfile.windows.
BSYS6_REPO=https://codeberg.org/librewolf/bsys6.git
BSYS6_COMMIT=af13a34f7e24ac63b9228b840964e37af042579a

# Base image of the build container (build/windows-cross.Dockerfile), by digest.
DEBIAN_IMAGE=debian:trixie-slim@sha256:8aa5a7bf5a1955bddbe7d74fcdd0b91ab30e74362a8b73af672b0481b35b44a0

# Rust version used by bsys6 for this Firefox version (assets/Dockerfile.windows).
RUST_VERSION=1.100

# uBlock Origin: pinned in Phase 5 to an AMO-signed xpi + sha256.
# Latest GitHub release seen 2026-11-25: 1.77.2 (published that day; AMO may lag).
UBO_ID=uBlock0@raymondhill.net
UBO_VERSION=
UBO_XPI_SHA256=
