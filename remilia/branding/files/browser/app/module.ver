# Remilia: version resource of the main executable (Properties > Details).
# Read as Latin-1 by config/create_rc.py: keep this file ASCII.
# An empty TRADEMARKS value replaces create_rc.py's default ("Mozilla").
WIN32_MODULE_COMPANYNAME=Remilia
WIN32_MODULE_COPYRIGHT=Remilia, LibreWolf, Firefox and Mozilla developers; available under the MPL 2 license.
WIN32_MODULE_PRODUCTVERSION=@MOZ_APP_WINVERSION@
WIN32_MODULE_PRODUCTVERSION_STRING=@MOZ_APP_VERSION@
WIN32_MODULE_TRADEMARKS=
WIN32_MODULE_DESCRIPTION=@MOZ_APP_DISPLAYNAME@
WIN32_MODULE_PRODUCTNAME=@MOZ_APP_DISPLAYNAME@
WIN32_MODULE_NAME=@MOZ_APP_DISPLAYNAME@
